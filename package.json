{
  "name": "crm-report-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "login": "playwright codegen https://qa-crm.asquareab.com --save-storage=auth.json",
    "test": "playwright test",
    "test:headed": "playwright test --headed --workers=1",
    "report": "playwright show-report",
    "db:check": "node scripts/db-check.mjs",
    "db:discover": "node scripts/db-discover.mjs",
    "test:db": "playwright test db",
    "test:scenarios": "playwright test --grep @scenario",
    "test:core": "playwright test --grep-invert \"@scenario|@pages|@lead-workbook|@customer-workbook|@broker-workbook|@marketing-workbook|@reservation-workbook|@spa-workbook|@collection-workbook|@exception-workbook|@executive-workbook|@leads-page|@lead-detail|@security|@inventory-page|@proposals-page|@contracts-page|@lead-insights-page|@opportunities-page|@reservations-page|@sales-workbook|@cb-workbook|@bc-workbook|@cu-workbook|@currency-workbook|@reference-data-workbook|@preferences-workbook\"",
    "test:pages": "playwright test --grep @pages",
    "test:hub": "playwright test --grep @hub",
    "test:lead-reports": "playwright test --grep @lead-reports",
    "test:sales-reports": "playwright test --grep @sales-reports",
    "test:inventory-reports": "playwright test --grep @inventory-reports",
    "test:customer-reports": "playwright test --grep @customer-reports",
    "test:broker-reports": "playwright test --grep @broker-reports",
    "test:marketing-reports": "playwright test --grep @marketing-reports",
    "test:reservation-reports": "playwright test --grep @reservation-reports",
    "test:spa-reports": "playwright test --grep @spa-reports",
    "test:collection-reports": "playwright test --grep @collection-reports",
    "test:executive-reports": "playwright test --grep @executive-reports",
    "test:exception-reports": "playwright test --grep @exception-reports",
    "test:lead-workbook": "playwright test tests/lead-reports",
    "test:customer-workbook": "playwright test tests/customer-reports",
    "test:broker-workbook": "playwright test tests/broker-reports",
    "test:marketing-workbook": "playwright test tests/marketing-reports",
    "test:reservation-workbook": "playwright test tests/reservation-reports",
    "test:spa-workbook": "playwright test tests/spa-reports",
    "test:collection-workbook": "playwright test tests/collection-reports",
    "test:exception-workbook": "playwright test tests/exception-reports",
    "test:executive-workbook": "playwright test tests/executive-reports",
    "test:leads-page": "playwright test tests/leads-page",
    "test:lead-detail": "playwright test tests/lead-detail",
    "test:security": "playwright test tests/security --workers=1",
    "test:inventory-page": "playwright test tests/inventory-page --workers=1 --retries=1",
    "test:proposals-page": "playwright test tests/proposals-page --workers=1 --retries=1",
    "test:contracts-page": "playwright test tests/contracts-page --workers=1 --retries=1",
    "test:lead-insights-page": "playwright test tests/lead-insights --workers=1 --retries=1",
    "test:opportunities-page": "playwright test tests/opportunities-page --workers=1 --retries=1",
    "test:reservations-page": "playwright test tests/reservations-page --workers=1 --retries=1",
    "test:sales-workbook": "playwright test tests/sales-reports",
    "test:customers-brokers": "playwright test tests/customers-brokers",
    "test:brokers-channels": "playwright test tests/brokers-channels",
    "test:construction-updates": "playwright test tests/construction-updates",
    "test:currency-master": "playwright test tests/currency-master --workers=1",
    "test:reference-data": "playwright test tests/reference-data --workers=1",
    "test:preferences": "playwright test tests/preferences --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  }
}
