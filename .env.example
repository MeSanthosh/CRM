# Copy this file to .env and fill in your QA database details.
# Use a READ-ONLY user on the QA database. Never production.
PGHOST=fricitra.cb40k68kyryq.ap-south-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=crm_dev
PGUSER=postgres
PGPASSWORD=your-password-here
# RDS requires SSL; set to false only for a local server without SSL
PGSSL=true
# Optional: schema that holds the CRM tables
PGSCHEMA=public

# CRM app login used by the tests (tests/global-setup.ts). Keep real values in .env only.
CRM_USERNAME=your-username
CRM_PASSWORD=your-password

# Set to true to skip every UI-vs-database test (DB-*, RA-010)
SKIP_DB_TESTS=false

# Service Requests suite (tests/service-request): SR-046 … SR-070 create ONE ticket per run on QA
# ("[AUTO] Service request test <timestamp>") and change only that ticket. Set to true to skip them.
SKIP_SR_WRITE_TESTS=false
# Optional: customer for that ticket (part of the name as shown in the Customer dropdown);
# default is a customer whose name contains "QA Test", else the first one in the list
SR_CUSTOMER=

# Customer Portal login (Service Requests SR-071, SR-072); leave empty to skip those tests
PORTAL_URL=https://qa-crmcustomer.asquareab.com
PORTAL_USERNAME=
PORTAL_PASSWORD=

# Login database (the login page offers crm_dev, crm_qa, crm_demo; default crm_qa)
CRM_DATABASE=crm_qa
